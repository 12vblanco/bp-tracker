# Copy to .env and fill in from Supabase → Project Settings → API.
#
# Both are safe in the client: the anon key is designed to ship in a browser
# bundle and is not what protects your readings. Row Level Security is. Never
# put the service_role key in here or anywhere in this repo — it bypasses RLS
# entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional single-user auto sign-in. Fill these and the app signs itself in on
# boot, so the Netlify site password is the only one you ever type.
#
# SINGLE USER ONLY. Unlike the anon key above, this password is a real
# credential and it ships in the client bundle — the Netlify basic-auth gate is
# the only thing keeping it private. If a second person ever gets an account,
# clear these and use the magic link instead.
VITE_BP_EMAIL=
VITE_BP_PASSWORD=
